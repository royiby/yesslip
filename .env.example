# ─────────────────────────────────────────────────────────────
#  Database
# ─────────────────────────────────────────────────────────────
# The app connects as a NON-OWNER role on purpose: a table's owner
# bypasses row-level security, which is the one wall standing between
# two tenants' data. See migrations/001_init.sql.
DATABASE_URL=postgres://yesslip_app:yesslip_app@localhost:5433/yesslip
# Owner connection, used only by `npm run migrate`.
DATABASE_ADMIN_URL=postgres://yesslip:yesslip@localhost:5433/yesslip

# ─────────────────────────────────────────────────────────────
#  Secret encryption
# ─────────────────────────────────────────────────────────────
# Base64 of 32 random bytes. Generate with: npm run keygen
#
# This wraps every tenant's data key, and those data keys encrypt the
# Morning API secrets. Losing it means every tenant has to reconnect
# Morning by hand; leaking it means someone can issue invoices and take
# refunds on behalf of every business on the platform. Keep it in the
# platform secret store, never in the repo, and never in a log line.
SECRETS_MASTER_KEY=

# ─────────────────────────────────────────────────────────────
#  Server
# ─────────────────────────────────────────────────────────────
PORT=3000
# Public https base. Morning returns here after a payment, and this is
# also what parents receive in WhatsApp.
PUBLIC_BASE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
#  Google login
# ─────────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials →
# OAuth client ID → Web application. Add this exact redirect URI:
#   <PUBLIC_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. Base64 of 32 random bytes: npm run keygen
#
# Separate from SECRETS_MASTER_KEY on purpose. This one only has to forge a
# login; that one decrypts every tenant's Morning credentials. They should not
# share a blast radius, and this is the one that gets rotated casually.
# Changing it signs everyone out.
SESSION_SECRET=
# How long a session lasts without signing in again.
SESSION_DAYS=30
